{
    "folders": [
        {
            "name": "sup-bot",
            "path": "./"
        },
    ],
    "settings": {
        "flake8.args": [
            "--max-line-length=99",
            "--extend-ignore=E203"
        ],
        "black-formatter.args": [
            "--skip-string-normalization",
            "--line-length=99",
            "--preview"
        ],
        "[python]": {
            "editor.defaultFormatter": "ms-python.black-formatter",
            "editor.formatOnSave": true,
            "editor.codeActionsOnSave": {
                "source.organizeImports": "explicit"
            }
        },
        "files.exclude": {
            "**/.pytest_cache": true,
            "**/__pycache__": true,
            "build": true,
            "**/*.egg-info": true
        }
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "python debug",
                "type": "debugpy",
                "purpose": [
                    "debug-test",
                    "debug-in-terminal"
                ],
                "request": "launch",
                "program": "${file}",
                "console": "integratedTerminal",
                "justMyCode": false
            }
        ]
    },
    "extensions": {
        "recommendations": [
            "ms-python.python",
            "ms-python.black-formatter",
            "ms-python.flake8",
            "ms-python.isort",
        ]
    },
}